          }
        },
        {
          "name": "List callbacks",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"responseFormat\")) {",
                  "    throw new Error(\"Asigna la variable de coleccion responseFormat (se llena ejecutando List APIs y List callbacks)\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Status 200 OK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Respuesta SUCCESS con tracking CLIS003\", () => {",
                  "    pm.expect(body.status).to.eql(\"SUCCESS\");",
                  "    pm.expect(body.tracking).to.eql(\"CLIS003\");",
                  "});",
                  "",
                  "pm.test(\"Todos los callbacks leen el formato pedido\", () => {",
                  "    pm.expect(body.data.callbacks).to.be.an(\"array\");",
                  "    body.data.callbacks.forEach((cb) => {",
                  "        pm.expect(cb.responseFormat).to.eql(pm.collectionVariables.get(\"responseFormat\"));",
                  "    });",
                  "});",
                  "",
                  "if (body.data.callbacks && body.data.callbacks.length > 0) {",
                  "    pm.collectionVariables.set(\"callbackFunction\", body.data.callbacks[0].name);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/list/callbacks?responseFormat={{responseFormat}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "list",
                "callbacks"
              ],
              "query": [
                {
                  "key": "responseFormat",
                  "value": "{{responseFormat}}",
                  "description": "response_format de la API elegida (mayusculas, numeros y guion bajo)"
                }
              ]
            },
            "description": "Lista los callbacks compatibles con el `responseFormat` de la API elegida. Asigna `callbackFunction` con el primero."
          }
        },
