                  "pm.test(\"Status 400 Bad Request\", () => {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Respuesta FAIL con tracking CC004\", () => {",
                  "    pm.expect(body.status).to.eql(\"FAIL\");",
                  "    pm.expect(body.tracking).to.eql(\"CC004\");",
                  "});",
                  "",
                  "pm.test(\"El error viene en data.limit.details\", () => {",
                  "    pm.expect(body.data.limit.details).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/list/apis?limit=diez",
              "host": [
                "{{baseUrl}}"
