                  "    pm.expect(body.data.error).to.eql(\"Datos de entrada inválidos\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/list/callbacks?responseFormat=google-trends",
