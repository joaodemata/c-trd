    {
      "name": "Operation",
      "item": [
        {
          "name": "Create trigger",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El tag debe ser unico, se genera uno nuevo en cada ejecucion",
                  "pm.variables.set(\"triggerTag\", \"TRIGGER-TEST-\" + Date.now());",
                  "",
                  "if (!pm.collectionVariables.get(\"idAsset\")) {",
                  "    throw new Error(\"Asigna la variable de coleccion idAsset con el _id de un asset existente\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Status 201 Created\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Respuesta SUCCESS con tracking COPR003\", () => {",
                  "    pm.expect(body.status).to.eql(\"SUCCESS\");",
                  "    pm.expect(body.tracking).to.eql(\"COPR003\");",
                  "});",
                  "",
                  "pm.test(\"idTrigger es un ObjectID\", () => {",
                  "    pm.expect(body.data.idTrigger).to.match(/^[0-9a-f]{24}$/);",
                  "});",
                  "",
                  "if (body.data && body.data.idTrigger) {",
                  "    pm.collectionVariables.set(\"idTrigger\", body.data.idTrigger);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag\": \"{{triggerTag}}\",\n  \"name\": \"Trigger de prueba\",\n  \"description\": \"Trigger creado desde Postman para probar la API\",\n  \"idAsset\": \"{{idAsset}}\",\n  \"idAction\": \"{{idAction}}\",\n  \"idCandlestickTimeframe\": \"{{idCandlestickTimeframe}}\",\n  \"maxCandlestickQty\": 6,\n  \"conditions\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/operation/create/trigger",
              "host": [
