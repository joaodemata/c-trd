# Runner de los agentes, uno por entorno: /opt/ctrd/agents/env/<env>.env (permisos 600, dueño ctrd-agent)
# Nunca guardar valores reales en este archivo de ejemplo

# URL publica de la API del entorno
CTRD_AGENT_API_URL=https://api.<domain>
# Usuario agente creado con scripts/create_agent_user.js
CTRD_AGENT_USERNAME=claude
CTRD_AGENT_PASSWORD=

# Opcionales
# CTRD_AGENT_MODEL=opus
# CTRD_AGENT_MAX_ATTEMPTS=3
# CTRD_AGENT_CLAUDE_BIN=/home/ctrd-agent/.local/bin/claude

# Solo si Claude Code se autentica con un token largo (claude setup-token) en vez del login interactivo
# CLAUDE_CODE_OAUTH_TOKEN=
