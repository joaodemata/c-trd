# Copiar como dev.env, qa.env, sandbox.env y prod.env, cambiando los valores de cada entorno
JM_CTRD_MDB_HOST=mongodb://ctrd_prod:change-me@mongo:27017/ctrd_prod?authSource=admin
JM_CTRD_MDB_NAME=ctrd_prod
JM_CTRD_MDB_USER=ctrd_prod
# Frontend F-CTRD del mismo entorno (dev.app., qa.app., sandbox.app. o app.)
JM_CTRD_CORS_ORIGINS=https://app.yourdomain.com
# false en dev y qa para no gastar las cuotas de las APIs externas
JM_CTRD_CRON_ENABLED=true
JM_CTRD_STOCK_API_URL=https://www.alphavantage.co/query
JM_CTRD_API_KEY=
JM_CTRD_SECRET_ALPHAVANTAGE_APIKEY=
JM_CTRD_SECRET_FINNHUB=
JM_CTRD_SECRET_COINMARKETCAP=
JM_CTRD_SECRET_FRED=
